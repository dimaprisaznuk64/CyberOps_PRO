# --- App ---
APP_ENV=dev
DEBUG=true
LOG_JSON=false

# --- Database ---
POSTGRES_USER=cyberops
POSTGRES_PASSWORD=cyberops
POSTGRES_DB=cyberops
DATABASE_URL=postgresql+asyncpg://cyberops:cyberops@localhost:5432/cyberops

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Scanning (етика: тільки власна мережа) ---
SCAN_ALLOW_PUBLIC=false
NMAP_TIMEOUT_SECONDS=300

# --- Secrets (НЕ комітити справжні значення) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Roles ---
DEFAULT_ROLE=user

# --- CORS ---
CORS_ORIGINS=*

# --- Seed admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
