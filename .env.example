# --- App ---
APP_ENV=dev
DEBUG=true
LOG_JSON=false

# --- Database ---
POSTGRES_USER=cyberops
POSTGRES_PASSWORD=cyberops
POSTGRES_DB=cyberops
DATABASE_URL=postgresql+asyncpg://cyberops:cyberops@localhost:5432/cyberops

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0

# --- RabbitMQ events ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_ENABLED=true

# --- Realtime (WebSocket) ---
# memory — in-process (dev), redis — через pub/sub в compose
REALTIME_MODE=memory

# --- Observability ---
LOG_JSON=false
TRACING_ENABLED=false
OTLP_ENDPOINT=http://localhost:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=admin
WORKER_METRICS_PORT=9091

# --- Scanning (етика: тільки власна мережа) ---
SCAN_ALLOW_PUBLIC=false
NMAP_TIMEOUT_SECONDS=300

# --- Secrets (НЕ комітити справжні значення) ---
# JWT_SECRET має бути >= 32 байт, інакше застосунок не стартує.
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-now
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Roles ---
DEFAULT_ROLE=user

# --- CORS ---
CORS_ORIGINS=*

# --- API Gateway / services (v0.7) ---
# Gateway маршрутизує /api/v1/auth|users|audit-logs -> auth, решту -> core
AUTH_SERVICE_URL=http://localhost:8002
CORE_SERVICE_URL=http://localhost:8001

# --- Rate limiting (v1.1) ---
# Лічильник у пам'яті процесу: при кількох репліках gateway кожна рахує
# ліміт незалежно (для спільного ліміту потрібен Redis).
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=5
AUTH_RATE_LIMIT_BURST=5
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_BURST=120
RATE_LIMIT_MAX_KEYS=10000

# --- Security headers (v1.1) ---
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# --- TLS на gateway (v1.1) ---
# Порожні значення = gateway слухає HTTP (TLS на балансувальнику).
# Щоб увімкнути TLS, покладіть cert.pem/key.pem у ./certs і задайте шляхи.
TLS_CERTS_DIR=./certs
GATEWAY_TLS_CERTFILE=
GATEWAY_TLS_KEYFILE=
GATEWAY_TLS_KEYFILE_PASSWORD=
GATEWAY_TLS_VERSION=2
GATEWAY_TLS_CIPHERS=ECDHE+AESGCM:ECDHE+CHACHA20:ECDHE+AES256:ECDHE+AES128

# --- Container images (v0.8) ---
# Префікс та тег образів для `docker compose build` / kind
IMAGE_PREFIX=cyberops
IMAGE_TAG=latest

# --- AI Security Assistant (v1.0) ---
# AI_PROVIDER: "" = локальні правила, "ollama"/"openai"/"openai-compatible" = llm
# Для Ollama: AI_PROVIDER=ollama, AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=llama3.2
AI_PROVIDER=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30.0

# --- Канали сповіщень: Email (v1.1) ---
# Локальний стенд (без зовнішніх серверів):
#   docker compose --profile mail up -d
#   SMTP_ENABLED=true
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_STARTTLS=false
#   пошта переглядається на http://localhost:8025
NOTIFICATIONS_ENABLED=true
APP_BASE_URL=http://localhost:3000
NOTIFY_MIN_SEVERITY=high
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cyberops@localhost
SMTP_FROM_NAME=CyberOps PRO
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10.0

# --- Канали сповіщень: Telegram (v1.1) ---
# Токен від @BotFather. Щоб дізнатися chat id — напишіть боту, потім
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10.0

# --- Seed admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
